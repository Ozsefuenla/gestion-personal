@inherits LayoutComponentBase
@layout MainLayout
@inject IJSRuntime Js
@inject ICurrentUser CurrentUser
@inject IDialogService DialogService

<MudLayout>
    <MudAppBar Elevation="0" Class="app-appbar">
        <span class="app-brand">GestionPersonal</span>
        <MudSpacer />
        @if (_centerName is not null)
        {
            <span class="d-none d-sm-flex app-center-chip">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                <span>@_centerName</span>
            </span>
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit" OnClick="LogoutAsync" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? _centerName;
    private bool _forceChangeShown;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _centerName = state.User.FindFirst("centerName")?.Value;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _forceChangeShown || !CurrentUser.MustChangePassword)
        {
            return;
        }

        _forceChangeShown = true;

        var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, CloseButton = false };
        var dialog = await DialogService.ShowAsync<ChangePasswordDialog>("Debes cambiar tu contraseña", options);
        await dialog.Result;
    }

    private async Task LogoutAsync()
    {
        if (CurrentUser.Role == UserRole.CenterWorker)
        {
            await Js.InvokeVoidAsync("workerLogout");
            return;
        }

        await Js.InvokeVoidAsync("centerLogout");
    }
}
