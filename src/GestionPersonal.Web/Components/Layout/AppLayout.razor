@inherits LayoutComponentBase
@layout MainLayout
@inject IJSRuntime Js

<MudLayout>
    <MudAppBar Elevation="0" Class="app-appbar">
        <span class="app-brand">GestionPersonal</span>
        <MudSpacer />
        @if (_centerName is not null)
        {
            <span class="d-none d-sm-flex app-center-chip">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Small" />
                <span>@_centerName</span>
            </span>
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit" OnClick="LogoutAsync" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private string? _centerName;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _centerName = state.User.FindFirst("centerName")?.Value;
        }
    }

    private async Task LogoutAsync() => await Js.InvokeVoidAsync("centerLogout");
}
