@inherits LayoutComponentBase
@layout MainLayout
@inject IJSRuntime Js
@inject CenterTokenStore TokenStore

<MudLayout>
    <MudAppBar Elevation="0" Class="app-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <span class="app-brand">GestionPersonal</span>
        <MudSpacer />
        @if (_centerName is not null)
        {
            <MudChip T="string" Icon="@Icons.Material.Filled.Storefront" Color="Color.Default" Variant="Variant.Outlined" Class="d-none d-sm-flex">
                @_centerName
            </MudChip>
        }
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.ExitToApp" Color="Color.Inherit" OnClick="LogoutAsync" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Class="app-drawer">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Panel</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/app" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/app" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Schedule">Control horario</MudNavLink>
            <MudNavLink Href="/app" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Equipo</MudNavLink>
            <MudNavLink Href="/app" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.EventBusy" Disabled="true">Vacaciones</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private bool _drawerOpen = true;
    private string? _centerName;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var state = await AuthState;
            _centerName = state.User.FindFirst("centerName")?.Value;
            TokenStore.Token = state.User.FindFirst("jwt")?.Value;
        }
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync() => await Js.InvokeVoidAsync("centerLogout");
}
