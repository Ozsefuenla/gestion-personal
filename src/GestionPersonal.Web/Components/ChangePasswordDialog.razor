@inject IJSRuntime Js
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Debes cambiar tu contraseña</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Tu contraseña ha sido reseteada o es temporal. Establece una nueva para continuar.
        </MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudForm OnEnterPressed="SaveAsync">
            @if (!HasCurrentPassword)
            {
                <MudTextField @ref="_currentField"
                              T="string"
                              Value="_currentPassword"
                              ValueChanged="@((string v) => _currentPassword = v ?? "")"
                              Immediate="true"
                              InputType="InputType.Password"
                              Label="Contraseña actual"
                              Variant="Variant.Outlined"
                              Class="mb-4" />
            }

            <MudTextField T="string"
                          Value="_newPassword"
                          ValueChanged="@((string v) => _newPassword = v ?? "")"
                          Immediate="true"
                          InputType="InputType.Password"
                          Label="Nueva contraseña"
                          Variant="Variant.Outlined"
                          Class="mb-4" />

            <MudTextField T="string"
                          Value="_repeatPassword"
                          ValueChanged="@((string v) => _repeatPassword = v ?? "")"
                          Immediate="true"
                          InputType="InputType.Password"
                          Label="Repetir nueva contraseña"
                          Variant="Variant.Outlined" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" OnClick="LogoutAsync">Cerrar sesión</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">
            @(_busy ? "Guardando..." : "Guardar contraseña")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter]
    public string? CurrentPassword { get; set; }

    private MudTextField<string> _currentField = default!;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _repeatPassword = "";
    private string? _error;
    private bool _busy;

    private bool HasCurrentPassword => !string.IsNullOrEmpty(CurrentPassword);

    protected override void OnInitialized()
    {
        _currentPassword = CurrentPassword ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !HasCurrentPassword)
        {
            await Task.Delay(200);
            await _currentField.FocusAsync();
        }
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _error = "Introduce tu contraseña actual.";
            return;
        }

        if (_newPassword.Length < 4)
        {
            _error = "La nueva contraseña debe tener al menos 4 caracteres.";
            return;
        }

        if (_newPassword != _repeatPassword)
        {
            _error = "Las contraseñas nuevas no coinciden.";
            return;
        }

        _busy = true;

        try
        {
            var result = await Js.InvokeAsync<ChangePasswordResult>(
                "changeCenterPassword", _currentPassword, _newPassword);

            if (!result.Ok)
            {
                _error = result.Error;
                return;
            }

            Snackbar.Add("Contraseña actualizada", Severity.Success);
            DialogInstance.Close(DialogResult.Ok(true));
        }
        catch (Exception)
        {
            _error = "No se pudo cambiar la contraseña. Inténtalo de nuevo.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LogoutAsync()
    {
        await Js.InvokeVoidAsync("centerLogout");
    }

    private sealed record ChangePasswordResult(bool Ok, string? Error);
}
