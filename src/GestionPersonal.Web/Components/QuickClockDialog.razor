@inject IWorkersService Workers
@inject ITimeEntriesService TimeEntries
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(_action) ? "Logarse" : "Fichaje rápido")</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body1">Introduce tu PIN de trabajador</MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
        }

        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">@_message</MudAlert>
        }

        @if (_availableActions.Count > 0)
        {
            <div class="d-flex flex-column gap-2 mt-4">
                @foreach (var action in _availableActions)
                {
                    <MudButton Variant="Variant.Filled" Color="@ActionColor(action)" FullWidth="true" OnClick="@(() => SubmitAsync(action))">
                        <MudIcon Icon="@ActionIcon(action)" Class="mr-2" />
                        @ActionLabel(action)
                    </MudButton>
                }
            </div>
        }
        else
        {
            <MudTextField @ref="_pinField"
                          T="string"
                          Value="_pin"
                          ValueChanged="OnPinChanged"
                          Immediate="true"
                          InputType="InputType.Password"
                          InputMode="InputMode.numeric"
                          MaxLength="4"
                          Label="PIN"
                          Placeholder="••••"
                          Variant="Variant.Outlined"
                          Class="mt-4" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel">Cancelar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter]
    public string? Action { get; set; }

    [Parameter]
    public int WorkerId { get; set; }

    private MudTextField<string> _pinField = default!;
    private string _pin = "";
    private string _action = "";
    private string? _error;
    private string? _message;
    private IReadOnlyList<string> _availableActions = [];

    protected override void OnInitialized()
    {
        _action = Action ?? "";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(200);
            await _pinField.FocusAsync();
        }
    }

    private async Task OnPinChanged(string value)
    {
        _pin = new string(value.Where(char.IsDigit).Take(4).ToArray());
        _error = null;
        _message = null;

        if (_pin.Length != 4)
        {
            return;
        }

        if (string.IsNullOrEmpty(_action))
        {
            await LoginAsync();
            return;
        }

        await SubmitAsync(_action);
    }

    private async Task LoginAsync()
    {
        var result = await Workers.LoginAsync(new LoginCommand(WorkerId, _pin));

        if (result.IsFailure)
        {
            _availableActions = [];
            _message = null;
            _error = result.Error.Message;
            _pin = "";
            await _pinField.FocusAsync();
            return;
        }

        DialogInstance.Close(DialogResult.Ok(result.Value));
    }

    private async Task SubmitAsync(string action)
    {
        _action = action;

        var result = await TimeEntries.QuickClockAsync(new QuickClockCommand(WorkerId, _pin, action));

        if (result.IsFailure)
        {
            _availableActions = [];
            _message = null;
            _error = result.Error.Message;
            _pin = "";
            await _pinField.FocusAsync();
            return;
        }

        var quickClock = result.Value;

        if (quickClock.MustChangePin)
        {
            var newPin = await ForceChangePinAsync();

            if (newPin is not null)
            {
                _pin = newPin;
                await SubmitAsync(action);
            }

            return;
        }

        if (quickClock.Success)
        {
            Snackbar.Add("Fichaje realizado correctamente", Severity.Success);
            DialogInstance.Close(DialogResult.Ok(true));
            return;
        }

        if (quickClock.StaleEntryDate is { } staleDate)
        {
            if (await OpenCloseStaleAsync(staleDate, quickClock.StaleEntryStartedAt))
            {
                DialogInstance.Close(DialogResult.Ok(true));
            }

            return;
        }

        _message = quickClock.Message;
        _availableActions = quickClock.AvailableActions;
        _error = null;

        if (_availableActions.Count == 0)
        {
            _pin = "";
            await _pinField.FocusAsync();
        }
    }

    private async Task<string?> ForceChangePinAsync()
    {
        var parameters = new DialogParameters
        {
            ["WorkerId"] = WorkerId,
            ["AllowCancel"] = false,
            ["CurrentPin"] = _pin
        };

        var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false };

        var dialog = await DialogService.ShowAsync<ChangePinDialog>("Debes cambiar tu PIN", parameters, options);
        var dialogResult = await dialog.Result;

        return dialogResult is { Canceled: false, Data: string newPin } ? newPin : null;
    }

    private async Task<bool> OpenCloseStaleAsync(DateOnly staleDate, DateTimeOffset? staleStartedAt)
    {
        var parameters = new DialogParameters
        {
            ["WorkerId"] = WorkerId,
            ["StaleDate"] = staleDate,
            ["IsKiosk"] = true,
            ["Pin"] = _pin,
            ["StaleStartedAt"] = staleStartedAt
        };

        var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false };

        var dialog = await DialogService.ShowAsync<CloseStaleDialog>("Finalizar jornada anterior", parameters, options);
        var dialogResult = await dialog.Result;

        return dialogResult is not null && !dialogResult.Canceled;
    }

    private void Cancel() => DialogInstance.Cancel();

    private static string ActionLabel(string action) => action switch
    {
        "start" => "Iniciar",
        "pause" => "Pausar",
        "end" => "Finalizar",
        _ => action
    };

    private static string ActionIcon(string action) => action switch
    {
        "start" => Icons.Material.Filled.PlayArrow,
        "pause" => Icons.Material.Filled.Pause,
        "end" => Icons.Material.Filled.Stop,
        _ => Icons.Material.Filled.Check
    };

    private static Color ActionColor(string action) => action switch
    {
        "start" => Color.Success,
        "pause" => Color.Warning,
        "end" => Color.Secondary,
        _ => Color.Primary
    };
}
