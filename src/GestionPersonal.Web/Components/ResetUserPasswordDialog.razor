@inject IPlatformService Platform
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Resetear contraseña</MudText>
    </TitleContent>

    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">Usuario: <b>@Username</b></MudText>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudTextField T="string"
                      Value="_password"
                      ValueChanged="@((string v) => _password = v ?? "")"
                      Immediate="true"
                      InputType="InputType.Password"
                      Label="Nueva contraseña"
                      Variant="Variant.Outlined"
                      Class="mb-4" />

        <MudTextField T="string"
                      Value="_repeat"
                      ValueChanged="@((string v) => _repeat = v ?? "")"
                      Immediate="true"
                      InputType="InputType.Password"
                      Label="Repetir contraseña"
                      Variant="Variant.Outlined" />

        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3">
            El usuario deberá usar esta contraseña en su próximo acceso.
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="_busy">Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public string Username { get; set; } = "";

    private string _password = "";
    private string _repeat = "";
    private string? _error;
    private bool _busy;

    private async Task SaveAsync()
    {
        _error = null;

        if (_password.Length < 4)
        {
            _error = "La contraseña debe tener al menos 4 caracteres.";
            return;
        }

        if (_password != _repeat)
        {
            _error = "Las contraseñas no coinciden.";
            return;
        }

        _busy = true;

        try
        {
            var result = await Platform.ResetCenterUserPasswordAsync(
                new ResetCenterUserPasswordCommand(UserId, _password));

            if (result.IsFailure)
            {
                _error = result.Error.Message;
                return;
            }

            Snackbar.Add("Contraseña actualizada", Severity.Success);
            DialogInstance.Close(DialogResult.Ok(true));
        }
        finally
        {
            _busy = false;
        }
    }

    private void Cancel() => DialogInstance.Cancel();
}
