@inject ApiClient Api
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Elevation="2" Class="h-100">
    <MudCardContent>
        <MudText Typo="Typo.h6">@Worker.FullName</MudText>
        <div class="mt-2">
            <MudChip T="string" Color="@StatusColor" Variant="Variant.Filled" Size="Size.Small">@StatusLabel</MudChip>
        </div>
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="!CanIniciar" OnClick="@(() => ExecuteAsync("start"))">
            Iniciar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="!CanPause" OnClick="@(() => ExecuteAsync("pause"))">
            Pausar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="!CanEnd" OnClick="@(() => ExecuteAsync("end"))">
            Finalizar
        </MudButton>
    </MudCardActions>

    @if (ShowProfileButtons)
    {
        <MudDivider />
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="OpenChangePinAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Password" Class="mr-2" />
                        Cambiar PIN
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="@(() => ToggleTimeControl.InvokeAsync())">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-2" />
                        Control Horario
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="mr-2" />
                        Ausencias
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" OnClick="@(() => LogoutAsync.InvokeAsync())">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Cerrar sesión
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    }
</MudCard>

@code {
    [Parameter, EditorRequired]
    public required WorkerStatus Worker { get; set; }

    [Parameter]
    public EventCallback RefreshAsync { get; set; }

    [Parameter]
    public bool ShowProfileButtons { get; set; }

    [Parameter]
    public EventCallback LogoutAsync { get; set; }

    [Parameter]
    public EventCallback ToggleTimeControl { get; set; }

    private bool CanIniciar => Worker.CurrentStatus is "idle" or "paused";
    private bool CanPause => Worker.CurrentStatus == "in-progress";
    private bool CanEnd => Worker.CurrentStatus is "in-progress" or "paused";

    private Color StatusColor => Worker.CurrentStatus switch
    {
        "in-progress" => Color.Success,
        "paused" => Color.Warning,
        "finished" => Color.Info,
        _ => Color.Default
    };

    private string StatusLabel => Worker.CurrentStatus switch
    {
        "in-progress" => "En curso",
        "paused" => "En pausa",
        "finished" => "Finalizado",
        _ => "Sin iniciar"
    };

    private async Task OpenChangePinAsync()
    {
        var parameters = new DialogParameters { ["WorkerId"] = Worker.Id };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ChangePinDialog>("Cambiar PIN", parameters, options);
        await dialog.Result;
    }

    private async Task ExecuteAsync(string action)
    {
        try
        {
            switch (action)
            {
                case "start":
                    if (Worker.CurrentStatus == "paused")
                    {
                        await Api.ResumeAsync(Worker.Id);
                    }
                    else
                    {
                        await Api.StartAsync(Worker.Id);
                    }
                    break;
                case "pause":
                    await Api.PauseAsync(Worker.Id);
                    break;
                case "end":
                    await Api.EndAsync(Worker.Id);
                    break;
            }

            await RefreshAsync.InvokeAsync();
            Snackbar.Add("Acción registrada correctamente", Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo realizar la acción", Severity.Error);
        }
    }
}
