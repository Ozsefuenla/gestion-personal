@inject ITimeEntriesService TimeEntries
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Elevation="2" Class="h-100">
    <MudCardContent>
        <MudText Typo="Typo.h6">@Worker.FullName</MudText>
        <div class="mt-2">
            <MudChip T="string" Color="@StatusColor" Variant="Variant.Filled" Size="Size.Small">@StatusLabel</MudChip>
        </div>
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="!CanIniciar" OnClick="@(() => ExecuteAsync("start"))">
            Iniciar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="!CanPause" OnClick="@(() => ExecuteAsync("pause"))">
            Pausar
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="!CanEnd" OnClick="@(() => ExecuteAsync("end"))">
            Finalizar
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenAddMarkingAsync">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-2" />
            Añadir marcaje
        </MudButton>
    </MudCardActions>

    @if (ShowProfileButtons)
    {
        <MudDivider />
        <MudCardContent>
            <MudGrid Spacing="2">
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="OpenChangePinAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Password" Class="mr-2" />
                        Cambiar PIN
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="@(() => ToggleTimeControl.InvokeAsync())">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-2" />
                        Control Horario
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" OnClick="@(() => ToggleAbsences.InvokeAsync())">
                        @if (PendingAbsences > 0)
                        {
                            <MudBadge Content="@PendingAbsences" Color="Color.Error" Bordered="true" Overlap="true" Class="mr-2">
                                <MudIcon Icon="@Icons.Material.Filled.EventBusy" />
                            </MudBadge>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Class="mr-2" />
                        }
                        Ausencias
                    </MudButton>
                </MudItem>
                <MudItem xs="6">
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" OnClick="@(() => LogoutAsync.InvokeAsync())">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                        Cerrar sesión
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    }
</MudCard>

@code {
    [Parameter, EditorRequired]
    public required WorkerStatusResponse Worker { get; set; }

    [Parameter]
    public EventCallback RefreshAsync { get; set; }

    [Parameter]
    public bool ShowProfileButtons { get; set; }

    [Parameter]
    public EventCallback LogoutAsync { get; set; }

    [Parameter]
    public EventCallback ToggleTimeControl { get; set; }

    [Parameter]
    public EventCallback ToggleAbsences { get; set; }

    [Parameter]
    public int PendingAbsences { get; set; }

    private bool CanIniciar => Worker.CurrentStatus is "idle" or "paused";
    private bool CanPause => Worker.CurrentStatus == "in-progress";
    private bool CanEnd => Worker.CurrentStatus is "in-progress" or "paused";

    private Color StatusColor => Worker.CurrentStatus switch
    {
        "in-progress" => Color.Success,
        "paused" => Color.Warning,
        "finished" => Color.Info,
        _ => Color.Default
    };

    private string StatusLabel => Worker.CurrentStatus switch
    {
        "in-progress" => "En curso",
        "paused" => "En pausa",
        "finished" => "Finalizado",
        _ => "Sin iniciar"
    };

    private async Task OpenAddMarkingAsync()
    {
        var parameters = new DialogParameters { ["WorkerId"] = Worker.Id };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddMarkingDialog>("Añadir marcaje", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await RefreshAsync.InvokeAsync();
        }
    }

    private async Task OpenChangePinAsync()
    {
        var parameters = new DialogParameters { ["WorkerId"] = Worker.Id };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ChangePinDialog>("Cambiar PIN", parameters, options);
        await dialog.Result;
    }

    private async Task ExecuteAsync(string action)
    {
        Result result;

        switch (action)
        {
            case "start":
                result = Worker.CurrentStatus == "paused"
                    ? await TimeEntries.ResumeAsync(new ResumeTimeEntryCommand(Worker.Id))
                    : await TimeEntries.StartAsync(new StartTimeEntryCommand(Worker.Id));
                break;
            case "pause":
                result = await TimeEntries.PauseAsync(new PauseTimeEntryCommand(Worker.Id));
                break;
            case "end":
                result = await TimeEntries.EndAsync(new EndTimeEntryCommand(Worker.Id));
                break;
            default:
                return;
        }

        if (result.IsFailure)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        await RefreshAsync.InvokeAsync();
        Snackbar.Add("Acción registrada correctamente", Severity.Success);
    }
}
