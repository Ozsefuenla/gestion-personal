@page "/admin"
@attribute [Authorize(Roles = "SuperAdmin")]
@layout AppLayout
@inject IPlatformService Platform

<PageTitle>Administración de la plataforma</PageTitle>

<MudTabs Elevation="0" Outlined="true" Rounded="true" Class="mt-2">
    <MudTabPanel Text="Centros">
        <MudText Typo="Typo.h5" Class="mb-1">Centros</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Alta y baja de centros y de sus administradores</MudText>

        <MudCard Elevation="2" Class="mb-6">
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">Nuevo centro</MudText>

                @if (_createCenterError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@_createCenterError</MudAlert>
                }

                <div class="d-flex align-center flex-wrap" style="gap: 12px;">
                    <MudTextField T="string"
                                  Value="_newCenterName"
                                  ValueChanged="@((string v) => _newCenterName = v ?? "")"
                                  Immediate="true"
                                  Label="Nombre del centro"
                                  Variant="Variant.Outlined"
                                  Style="flex: 1; min-width: 220px;" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateCenterAsync" Disabled="_busy">
                        <MudIcon Icon="@Icons.Material.Filled.AddBusiness" Class="mr-2" />
                        Crear centro
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else
        {
            <MudTabs Elevation="0" Outlined="true">
                <MudTabPanel Text="@($"Activos ({_activeCenters.Count})")">
                    @if (_activeCenters.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">No hay centros activos.</MudText>
                    }
                    else
                    {
                        <MudExpansionPanels MultiExpansion="false" Elevation="0" Class="mt-2">
                            @foreach (var center in _activeCenters)
                            {
                                <AdminCenterPanel @key="center.Id" Center="center" OnChanged="LoadCentersAsync" />
                            }
                        </MudExpansionPanels>
                    }
                </MudTabPanel>

                <MudTabPanel Text="@($"Desactivados ({_inactiveCenters.Count})")">
                    @if (_inactiveCenters.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">No hay centros desactivados.</MudText>
                    }
                    else
                    {
                        <MudExpansionPanels MultiExpansion="false" Elevation="0" Class="mt-2">
                            @foreach (var center in _inactiveCenters)
                            {
                                <AdminCenterPanel @key="center.Id" Center="center" OnChanged="LoadCentersAsync" />
                            }
                        </MudExpansionPanels>
                    }
                </MudTabPanel>
            </MudTabs>
        }
    </MudTabPanel>

    <MudTabPanel Text="Monitorización">
        <AdminMonitoringPanel />
    </MudTabPanel>
</MudTabs>

@code {
    private List<CenterResponse> _centers = [];
    private string _newCenterName = "";
    private string? _createCenterError;
    private bool _loading = true;
    private bool _busy;

    private List<CenterResponse> _activeCenters =>
        _centers.Where(c => c.Active).OrderBy(c => c.Name).ToList();

    private List<CenterResponse> _inactiveCenters =>
        _centers.Where(c => !c.Active).OrderBy(c => c.Name).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCentersAsync();
    }

    private async Task LoadCentersAsync()
    {
        _loading = true;

        try
        {
            var result = await Platform.ListCentersAsync();

            if (result.IsFailure)
            {
                return;
            }

            _centers = result.Value.OrderBy(c => c.Name).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateCenterAsync()
    {
        _createCenterError = null;
        _busy = true;

        try
        {
            var result = await Platform.CreateCenterAsync(new CreateCenterCommand(_newCenterName));

            if (result.IsFailure)
            {
                _createCenterError = result.Error.Message;
                return;
            }

            _newCenterName = "";
            await LoadCentersAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
