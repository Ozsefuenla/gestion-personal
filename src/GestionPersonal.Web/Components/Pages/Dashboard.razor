@page "/app"
@attribute [Authorize]
@layout AppLayout
@inject IDialogService DialogService
@inject ICentersService Centers
@inject IWorkersService Workers
@inject IVacationsService Vacations

<PageTitle>Fichaje</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Fichaje</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">Control de fichaje del centro</MudText>

<MudGrid Spacing="4">
    <MudItem xs="12" md="4">
        @if (_loggedInWorker is null)
        {
            <QuickClockPanel CenterId="_centerId" />
        }
        else
        {
            <DonutProgress Worker="_loggedInWorker" RefreshAsync="RefreshWorkerAsync" />

            @if (_loggedInWorker.Role == "admin")
            {
                <TodayWorkersPanel />
            }
        }
    </MudItem>

    <MudItem xs="12" md="8">
        @if (_loggedInWorker is null)
        {
            <MudCard Elevation="2" Class="h-100">
                <MudCardContent>
                    <MudText Typo="Typo.h6">Acceso</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Identifícate para ver tus datos personales</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Class="mt-4" OnClick="OpenLoginAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                        Login
                    </MudButton>
                </MudCardContent>
            </MudCard>
        }
        else
        {
            <WorkerCard Worker="_loggedInWorker"
                        ShowProfileButtons="true"
                        RefreshAsync="RefreshWorkerAsync"
                        LogoutAsync="LogoutAsync"
                        ToggleTimeControl="ToggleTimeControlAsync"
                        ToggleAbsences="ToggleAbsencesAsync"
                        PendingAbsences="_pendingAbsences" />

            @if (_showTimeControl)
            {
                <div class="mt-4">
                    <TimeControlPanel Worker="_loggedInWorker" />
                </div>
            }

            @if (_showAbsences)
            {
                <div class="mt-4">
                    <AbsencesPanel Worker="_loggedInWorker"
                                   CenterId="_centerId"
                                   PendingAbsences="_pendingAbsences"
                                   Changed="RefreshPendingAsync" />
                </div>
            }
        }
    </MudItem>
</MudGrid>

@code {
    private WorkerStatusResponse? _loggedInWorker;
    private bool _showTimeControl;
    private bool _showAbsences;
    private int _pendingAbsences;
    private int _centerId;

    protected override async Task OnInitializedAsync()
    {
        var result = await Centers.ListAsync();

        if (result.IsFailure)
        {
            return;
        }

        var center = result.Value.FirstOrDefault();

        if (center is not null)
        {
            _centerId = center.Id;
        }
    }

    private async Task OpenLoginAsync()
    {
        var selectorOptions = new DialogOptions { CloseOnEscapeKey = true };
        var selector = await DialogService.ShowAsync<WorkerSelectorDialog>("Selecciona tu trabajador", new DialogParameters { ["CenterId"] = _centerId }, selectorOptions);
        var selectorResult = await selector.Result;

        if (selectorResult is null || selectorResult.Canceled || selectorResult.Data is not WorkerResponse worker)
        {
            return;
        }

        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<QuickClockDialog>("Logarse", new DialogParameters { ["WorkerId"] = worker.Id }, options);
        var result = await dialog.Result;

        if (result?.Data is WorkerStatusResponse loggedIn)
        {
            _loggedInWorker = loggedIn;
            await RefreshPendingAsync();

            if (loggedIn.MustChangePin)
            {
                await ForceChangePinAsync();
            }
        }
    }

    private async Task ForceChangePinAsync()
    {
        var parameters = new DialogParameters { ["WorkerId"] = _loggedInWorker!.Id };
        var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false };
        var dialog = await DialogService.ShowAsync<ChangePinDialog>("Debes cambiar tu PIN", parameters, options);
        await dialog.Result;
        await RefreshWorkerAsync();
    }

    private async Task RefreshWorkerAsync()
    {
        if (_loggedInWorker is null)
        {
            return;
        }

        var result = await Workers.GetStatusAsync(_loggedInWorker.Id);

        if (result.IsSuccess)
        {
            _loggedInWorker = result.Value;
        }
    }

    private async Task RefreshPendingAsync()
    {
        if (_loggedInWorker is null || _loggedInWorker.Role != "admin")
        {
            _pendingAbsences = 0;
            return;
        }

        var result = await Vacations.ListCenterAsync();

        if (result.IsFailure)
        {
            _pendingAbsences = 0;
            return;
        }

        _pendingAbsences = result.Value.Count(v => v.Status == "pending");
    }

    private Task ToggleTimeControlAsync()
    {
        _showTimeControl = !_showTimeControl;
        _showAbsences = false;
        return Task.CompletedTask;
    }

    private Task ToggleAbsencesAsync()
    {
        _showAbsences = !_showAbsences;
        _showTimeControl = false;
        return Task.CompletedTask;
    }

    private Task LogoutAsync()
    {
        _loggedInWorker = null;
        _showTimeControl = false;
        _showAbsences = false;
        _pendingAbsences = 0;
        return Task.CompletedTask;
    }
}
