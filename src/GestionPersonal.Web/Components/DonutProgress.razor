@using System.Globalization
@implements IAsyncDisposable
@inject ITimeEntriesService TimeEntries
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Elevation="2" Class="h-100">
    <MudCardContent>
        <MudText Typo="Typo.h6">Resumen</MudText>

        <svg viewBox="0 0 100 100" style="width: 180px; height: 180px; display: block; margin: 16px auto 0;">
            <circle cx="50" cy="50" r="40" fill="none" stroke="#e0e0e0" stroke-width="12" />
            <circle cx="50" cy="50" r="40" fill="none" stroke="#43a047" stroke-width="12"
                    stroke-dasharray="@WorkedDashArray"
                    transform="rotate(-90 50 50)" />
            <text x="50" y="50" text-anchor="middle" dominant-baseline="central" font-size="18" font-weight="600" fill="#1F1B2E">@PercentLabel</text>
        </svg>

        <div class="donut-stats">
            <div class="donut-stat">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Trabajando</MudText>
                <MudText Typo="Typo.body2" Class="tabular-nums"><b>@TimeFormatting.FormatLiveDuration(Live.Worked)</b></MudText>
            </div>
            <div class="donut-stat">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Pausado</MudText>
                <MudText Typo="Typo.body2" Class="tabular-nums"><b>@TimeFormatting.FormatLiveDuration(Live.Paused)</b></MudText>
            </div>
            <div class="donut-stat">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Restante</MudText>
                <MudText Typo="Typo.body2" Class="tabular-nums"><b>@TimeFormatting.FormatRemaining(Remaining)</b></MudText>
            </div>
        </div>

        @if (Worker.Timeline.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">Sin actividad hoy.</MudText>
        }
        else
        {
            <div class="mt-2">
                @for (var i = 0; i < Worker.Timeline.Count; i++)
                {
                    var segment = Worker.Timeline[i];
                    var isLastActive = IsActive && i == Worker.Timeline.Count - 1;

                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Circle"
                                 Color="@(segment.Type == "working" ? Color.Success : Color.Warning)"
                                 Size="Size.Small" />
                        <MudText Typo="Typo.body2">@(segment.Type == "working" ? "Trabajando" : "Pausa")</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@MadridTime.Format(segment.From)</MudText>

                        @if (isLastActive)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenEditAsync(segment))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => OpenDeleteAsync(segment))" />
                        }
                    </div>
                }

                @if (EndedAt is not null)
                {
                    <div class="d-flex align-center" style="gap: 8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Info" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Finalizado</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@MadridTime.Format(EndedAt.Value)</MudText>
                    </div>
                }
            </div>
        }

    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public required WorkerStatusResponse Worker { get; set; }

    [Parameter]
    public EventCallback RefreshAsync { get; set; }

    private readonly PeriodicTimer _clock = new(TimeSpan.FromSeconds(1));

    protected override void OnInitialized() => _ = RunClockAsync();

    private async Task RunClockAsync()
    {
        while (true)
        {
            try
            {
                if (!await _clock.WaitForNextTickAsync())
                {
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                return;
            }
        }
    }

    private bool IsActive => Worker.CurrentStatus is "in-progress" or "paused";

    private (TimeSpan Worked, TimeSpan Paused) Live => LiveTime.Compute(Worker, DateTimeOffset.UtcNow);
    private TimeSpan Remaining => Worker.DailyHours - Live.Worked;

    private static double Circumference => 2 * Math.PI * 40;

    private double CompletionRatio =>
        Worker.DailyHours <= TimeSpan.Zero
            ? 0
            : Math.Clamp(Live.Worked.TotalSeconds / Worker.DailyHours.TotalSeconds, 0, 1);

    private double WorkedLength => CompletionRatio * Circumference;

    private string WorkedDashArray => $"{WorkedLength.ToString("F2", CultureInfo.InvariantCulture)} {Circumference.ToString("F2", CultureInfo.InvariantCulture)}";

    private string PercentLabel => $"{(int)Math.Round(CompletionRatio * 100)}%";

    private DateTimeOffset? EndedAt =>
        Worker.CurrentStatus == "finished" && Worker.Timeline.Count > 0
            ? Worker.Timeline[^1].To
            : null;

    private async Task OpenEditAsync(TimelineSegmentResponse segment)
    {
        var parameters = new DialogParameters
        {
            ["WorkerId"] = Worker.Id,
            ["CurrentStart"] = segment.From,
            ["HasPrevious"] = Worker.Timeline.Count > 1
        };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<EditActiveDialog>("Editar marcaje", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await RefreshAsync.InvokeAsync();
        }
    }

    private async Task OpenDeleteAsync(TimelineSegmentResponse segment)
    {
        var type = segment.Type == "working" ? "Trabajando" : "Pausa";
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Eliminar marcaje",
            $"¿Seguro de querer eliminar el marcaje {type} iniciado a las {MadridTime.Format(segment.From)}?",
            "Aceptar",
            "Cancelar");

        if (confirmed != true)
        {
            return;
        }

        var result = await TimeEntries.DeleteActiveAsync(Worker.Id);

        if (result.IsFailure)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        await RefreshAsync.InvokeAsync();
        Snackbar.Add("Marcaje eliminado correctamente", Severity.Success);
    }

    public ValueTask DisposeAsync()
    {
        _clock.Dispose();
        return ValueTask.CompletedTask;
    }
}
