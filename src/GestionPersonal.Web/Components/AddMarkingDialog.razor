@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Añadir marcaje</MudText>
    </TitleContent>

    <DialogContent>
        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        <MudSelect T="string" Label="Tipo" Value="_type" ValueChanged="OnTypeChanged" Variant="Variant.Outlined" Class="mb-4">
            <MudSelectItem T="string" Value="@("start")">Iniciar</MudSelectItem>
            <MudSelectItem T="string" Value="@("pause")">Pausa</MudSelectItem>
            <MudSelectItem T="string" Value="@("end")">Finalizar</MudSelectItem>
        </MudSelect>

        <MudDatePicker @bind-Date="_date" Label="Fecha" MaxDate="@DateTime.Today" Variant="Variant.Outlined" Class="mb-4" />

        @if (ShowStartTime)
        {
            <MudTimePicker @bind-Time="_startTime" Label="Hora de inicio" TimeEditMode="TimeEditMode.Normal" Variant="Variant.Outlined" Class="mb-4" />
        }

        @if (ShowEndTime)
        {
            <MudTimePicker @bind-Time="_endTime" Label="@(IsPause ? "Hora de final (opcional)" : "Hora de final")" TimeEditMode="TimeEditMode.Normal" Variant="Variant.Outlined" Class="mb-4" />
        }
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Default" OnClick="Cancel">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Añadir</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance DialogInstance { get; set; } = default!;

    [Parameter, EditorRequired]
    public required int WorkerId { get; set; }

    private string? _type;
    private DateTime? _date = DateTime.Today;
    private TimeSpan? _startTime;
    private TimeSpan? _endTime;
    private string? _error;

    private bool ShowStartTime => _type is "start" or "pause";
    private bool ShowEndTime => _type is "pause" or "end";
    private bool IsPause => _type == "pause";

    private void OnTypeChanged(string value)
    {
        _type = value;
        _error = null;
    }

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrEmpty(_type))
        {
            _error = "Selecciona un tipo de marcaje.";
            return;
        }

        if (_date is null)
        {
            _error = "Selecciona una fecha.";
            return;
        }

        if (ShowStartTime && _startTime is null)
        {
            _error = "Selecciona una hora de inicio.";
            return;
        }

        if (_type == "end" && _endTime is null)
        {
            _error = "Selecciona una hora de final.";
            return;
        }

        if (IsPause && _endTime is not null && _endTime <= _startTime)
        {
            _error = "La hora de final debe ser mayor a la hora de inicio.";
            return;
        }

        try
        {
            await Api.AddManualTimeEntryAsync(
                WorkerId,
                _type,
                DateOnly.FromDateTime(_date.Value),
                _startTime is null ? null : TimeOnly.FromTimeSpan(_startTime.Value),
                _endTime is null ? null : TimeOnly.FromTimeSpan(_endTime.Value));

            Snackbar.Add("Marcaje añadido correctamente", Severity.Success);
            DialogInstance.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void Cancel() => DialogInstance.Cancel();
}
