<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GestionPersonal.Web.styles.css"]" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script>
        window.getAntiforgeryToken = async () => {
            const res = await fetch('/auth/csrf', {
                credentials: 'same-origin',
                cache: 'no-store'
            });
            if (!res.ok) {
                throw new Error(`No se pudo obtener el token CSRF (${res.status})`);
            }
            const data = await res.json();
            return data.token;
        };

        window.centerLogin = async (username, password) => {
            try {
                const token = await window.getAntiforgeryToken();
                const res = await fetch('/auth/login', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ username, password })
                });
                if (res.ok) {
                    return { ok: true, error: null };
                }
                const data = await res.json().catch(() => ({}));
                return { ok: false, error: data.error || `Error ${res.status}` };
            } catch (e) {
                return { ok: false, error: 'No se pudo conectar. Inténtalo de nuevo.' };
            }
        };

        window.centerLogout = async () => {
            try {
                const token = await window.getAntiforgeryToken();
                await fetch('/auth/logout', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'RequestVerificationToken': token }
                });
            } catch (e) { }
            window.location.href = '/';
        };

        window.changeCenterPassword = async (currentPassword, newPassword) => {
            try {
                const token = await window.getAntiforgeryToken();
                const res = await fetch('/auth/change-password', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ currentPassword, newPassword })
                });
                if (res.ok) {
                    return { ok: true, error: null };
                }
                const data = await res.json().catch(() => ({}));
                return { ok: false, error: data.error || `Error ${res.status}` };
            } catch (e) {
                return { ok: false, error: 'No se pudo conectar. Inténtalo de nuevo.' };
            }
        };

        window.workerLogin = async (workerId, pin) => {
            try {
                const token = await window.getAntiforgeryToken();
                const res = await fetch('/auth/worker-login', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ workerId, pin })
                });
                if (res.ok) {
                    return { ok: true, error: null };
                }
                const data = await res.json().catch(() => ({}));
                return { ok: false, error: data.error || `Error ${res.status}` };
            } catch (e) {
                return { ok: false, error: 'No se pudo conectar. Inténtalo de nuevo.' };
            }
        };

        window.workerLogout = async () => {
            try {
                const token = await window.getAntiforgeryToken();
                await fetch('/auth/worker-logout', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'RequestVerificationToken': token }
                });
            } catch (e) { }
            window.location.href = '/app';
        };

        window.downloadFileFromStream = async (fileName, contentStreamReference) => {
            const arrayBuffer = await contentStreamReference.arrayBuffer();
            const blob = new Blob([arrayBuffer]);
            const url = URL.createObjectURL(blob);
            const anchorElement = document.createElement('a');
            anchorElement.href = url;
            anchorElement.download = fileName ?? '';
            anchorElement.click();
            anchorElement.remove();
            URL.revokeObjectURL(url);
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
