@inject ITimeEntriesService TimeEntries
@inject ISnackbar Snackbar
@inject TimeControlPdfExporter Exporter
@inject IJSRuntime Js

<MudCard Elevation="2">
    <MudCardContent>
        <div class="d-flex align-center justify-space-between flex-wrap" style="gap: 12px;">
            <MudText Typo="Typo.h6">Control Horario</MudText>
        </div>

        <div class="d-flex align-center flex-wrap mt-4" style="gap: 16px;">
            <div style="min-width: 180px;">
                <MudSelect T="int" Label="Mes" Value="_month" ValueChanged="OnMonthChanged">
                    @for (var i = 1; i <= 12; i++)
                    {
                        var month = i;
                        <MudSelectItem T="int" Value="@month">@TimeFormatting.MonthName(month)</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <div style="min-width: 140px;">
                <MudSelect T="int" Label="Año" Value="_year" ValueChanged="OnYearChanged">
                    @foreach (var year in Years)
                    {
                        <MudSelectItem T="int" Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
            </div>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ExportAsync" Disabled="@(_summary is null)">
                <MudIcon Icon="@Icons.Material.Filled.FileDownload" Class="mr-2" />
                Exportar
            </MudButton>
        </div>

        <MonthlyTimeControlView DailyHours="Worker.DailyHours" Summary="_summary" Year="_year" Month="_month" />
    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public required WorkerStatusResponse Worker { get; set; }

    private MonthlySummaryResponse? _summary;
    private int _year;
    private int _month;

    private IReadOnlyList<int> Years =>
        Enumerable.Range(DateTime.Now.Year - 5, 6).Reverse().ToList();

    protected override async Task OnInitializedAsync()
    {
        _year = DateTime.Now.Year;
        _month = DateTime.Now.Month;
        await LoadAsync();
    }

    private async Task OnMonthChanged(int value)
    {
        _month = value;
        await LoadAsync();
    }

    private async Task OnYearChanged(int value)
    {
        _year = value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _summary = null;

        var result = await TimeEntries.GetMonthlyAsync(new MonthlySummaryQuery(Worker.Id, _year, _month));

        if (result.IsFailure)
        {
            Snackbar.Add(result.Error.Message, Severity.Error);
            return;
        }

        _summary = result.Value;
    }

    private async Task ExportAsync()
    {
        if (_summary is null)
        {
            return;
        }

        try
        {
            var rows = new[] { new TimeControlExportWorker(Worker.FullName, _year, _month, Worker.DailyHours, _summary) };
            var bytes = Exporter.Build(rows);

            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await Js.InvokeVoidAsync("downloadFileFromStream", $"control-horario-{_year}-{_month:00}.pdf", streamRef);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo exportar el PDF", Severity.Error);
        }
    }
}
