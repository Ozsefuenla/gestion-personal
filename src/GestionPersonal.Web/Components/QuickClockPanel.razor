@inject IDialogService DialogService

<MudCard Elevation="2" Class="h-100">
    <MudCardContent>
        <MudText Typo="Typo.h6">Fichaje rápido</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Introduce tu PIN para fichar</MudText>

        <div class="d-flex flex-column gap-3 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" FullWidth="true" OnClick="@(() => OpenAsync("start"))">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Class="mr-2" />
                Iniciar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Large" FullWidth="true" OnClick="@(() => OpenAsync("pause"))">
                <MudIcon Icon="@Icons.Material.Filled.Pause" Class="mr-2" />
                Pausar
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" FullWidth="true" OnClick="@(() => OpenAsync("end"))">
                <MudIcon Icon="@Icons.Material.Filled.Stop" Class="mr-2" />
                Finalizar
            </MudButton>
        </div>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public EventCallback RefreshAsync { get; set; }

    private async Task OpenAsync(string action)
    {
        var parameters = new DialogParameters { ["Action"] = action };
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<QuickClockDialog>("Fichaje rápido", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await RefreshAsync.InvokeAsync();
        }
    }
}
