@using System.Globalization

<div class="d-flex" style="height: 12px; width: 100%; border-radius: 6px; overflow: hidden; background: #e0e0e0;">
    <div style="background: #43a047; width: @WorkedPercent%;"></div>
</div>

@code {
    [Parameter, EditorRequired]
    public required TimeSpan Worked { get; set; }

    [Parameter, EditorRequired]
    public required TimeSpan Target { get; set; }

    private string WorkedPercent
    {
        get
        {
            var target = Target.TotalMinutes;
            if (target <= 0)
            {
                return "0";
            }

            var percent = Math.Min(Worked.TotalMinutes, target) / target * 100;
            return percent.ToString("F2", CultureInfo.InvariantCulture);
        }
    }
}
