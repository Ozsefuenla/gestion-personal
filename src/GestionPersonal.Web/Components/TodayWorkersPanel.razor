@inject IWorkersService Workers
@inject IVacationsService Vacations
@inject ICurrentCenter CurrentCenter
@inject ITimeEntryChangeNotifier ChangeNotifier
@implements IAsyncDisposable

<MudCard Elevation="2">
    <MudCardContent>
        <MudText Typo="Typo.h6">Marcajes de hoy</MudText>

        @if (_loading && _workers.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-4">Cargando…</MudText>
        }
        else if (_workers.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">No hay trabajadores en el centro.</MudText>
        }
        else
        {
            <table class="today-grid mt-2">
                <colgroup>
                    <col style="width: 30%;" />
                    <col style="width: 18%;" />
                    <col style="width: 18%;" />
                    <col style="width: 17%;" />
                    <col style="width: 17%;" />
                </colgroup>
                <thead>
                    <tr>
                        <th>Trabajador</th>
                        <th>Estado</th>
                        <th>Trabajado</th>
                        <th>Restante</th>
                        <th>Pausado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var worker in _workers)
                    {
                        var worked = LiveWorked(worker);
                        var paused = LivePaused(worker);
                        var hasAbsence = _absencesToday.TryGetValue(worker.Id, out var absenceType);

                        <tr>
                            <td>@worker.FullName</td>
                            <td class="cell-status">
                                @if (hasAbsence)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Info">
                                        Ausencia - @AbsenceLabel(absenceType)
                                    </MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@StatusColor(worker.CurrentStatus)">
                                        @StatusLabel(worker.CurrentStatus)
                                    </MudChip>
                                }
                            </td>
                            <td class="tabular-nums">@(hasAbsence ? "—" : TimeFormatting.FormatLiveDuration(worked))</td>
                            <td class="tabular-nums">@(hasAbsence ? "—" : TimeFormatting.FormatRemaining(worker.DailyHours - worked))</td>
                            <td class="tabular-nums">@(hasAbsence ? "—" : TimeFormatting.FormatLiveDuration(paused))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<WorkerStatusResponse> _workers = [];
    private readonly Dictionary<int, string> _absencesToday = [];
    private bool _loading = true;
    private IDisposable? _subscription;
    private int _centerId;
    private readonly PeriodicTimer _clock = new(TimeSpan.FromSeconds(1));

    protected override async Task OnInitializedAsync()
    {
        _centerId = CurrentCenter.CenterId ?? 0;
        _subscription = ChangeNotifier.Subscribe(OnTimeEntryChanged);
        await LoadAsync();
        _ = RunClockAsync();
    }

    private async Task RunClockAsync()
    {
        while (true)
        {
            try
            {
                if (!await _clock.WaitForNextTickAsync())
                {
                    return;
                }

                await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                return;
            }
        }
    }

    private static TimeSpan LiveWorked(WorkerStatusResponse worker) =>
        LiveTime.Compute(worker, DateTimeOffset.UtcNow).Worked;

    private static TimeSpan LivePaused(WorkerStatusResponse worker) =>
        LiveTime.Compute(worker, DateTimeOffset.UtcNow).Paused;

    private void OnTimeEntryChanged(int centerId)
    {
        if (centerId != _centerId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        try
        {
            var statusesResult = await Workers.GetStatusesAsync();

            if (statusesResult.IsFailure)
            {
                return;
            }

            _workers = statusesResult.Value.OrderBy(w => w.FullName).ToList();

            var today = DateOnly.FromDateTime(DateTime.Today);
            var vacationsResult = await Vacations.ListCenterAsync();

            if (vacationsResult.IsFailure)
            {
                return;
            }

            _absencesToday.Clear();

            foreach (var vacation in vacationsResult.Value.Where(v => v.Status == "approved" && today >= v.StartDate && today <= v.EndDate))
            {
                _absencesToday[vacation.WorkerId] = vacation.Type;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private static string AbsenceLabel(string? type) => type switch
    {
        "vacations" => "Vacaciones",
        "sick-leave" => "Enfermedad",
        _ => "Otro"
    };

    private static Color StatusColor(string status) => status switch
    {
        "in-progress" => Color.Success,
        "paused" => Color.Warning,
        "finished" => Color.Info,
        _ => Color.Default
    };

    private static string StatusLabel(string status) => status switch
    {
        "in-progress" => "En curso",
        "paused" => "En pausa",
        "finished" => "Finalizado",
        _ => "Sin iniciar"
    };

    public ValueTask DisposeAsync()
    {
        _subscription?.Dispose();
        _clock.Dispose();
        return ValueTask.CompletedTask;
    }
}
